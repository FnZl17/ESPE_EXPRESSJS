// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         Role
  appointments Appointment[]
  enrolments   Enrollment[]
}

// Caso 8 · Cursos en línea: la matrícula vive en PostgreSQL (pago, sin duplicados).
// courseId guarda el _id del curso de MongoDB como texto (referencia entre bases, sin FK).
model Enrollment {
  id            Int           @id @default(autoincrement())
  user          User          @relation(fields: [userId], references: [id])
  userId        Int
  courseId      String?
  amount        Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Appointment {
  id          Int       @id @default(autoincrement())
  date        DateTime
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  timeBlock   TimeBlock @relation(fields: [timeBlockId], references: [id])
  timeBlockId Int
}

model TimeBlock {
  id        Int      @id @default(autoincrement())
  startTime DateTime
  endTime   DateTime
  appointments Appointment[]
}

enum Role {
  ADMIN
  USER
}