    {
      "name": "01 Registrar estudiante A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "const L = () => String.fromCharCode(65 + Math.floor(Math.random() * 26));",
              "pm.collectionVariables.set(\"runId\", runId);",
              "pm.collectionVariables.set(\"emailA\", \"a\" + runId + \"@test.com\");",
              "pm.collectionVariables.set(\"emailB\", \"b\" + runId + \"@test.com\");",
              "pm.collectionVariables.set(\"code\", L() + L() + L() + \"-\" + (100 + Math.floor(Math.random() * 900)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana Prueba\",\n  \"email\": \"{{emailA}}\",\n  \"password\": \"Clave123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
