              "const j = pm.response.json();",
              "pm.test(\"Devuelve token JWT\", () => pm.expect(j.token).to.be.a(\"string\"));",
              "const t = j.token; pm.collectionVariables.set(\"tokenA\", t); pm.collectionVariables.set(\"userIdA\", JSON.parse(atob(t.split(\".\")[1].replace(/-/g,\"+\").replace(/_/g,\"/\"))).id);"
